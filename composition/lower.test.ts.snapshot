{
  "digest": "52ca9c0a8eb2495f9f30fc106eeb6eac709d342f4702cc25e60987b03323c23e",
  "size": [
    1200,
    1600
  ],
  "text": [
    {
      "componentId": "headline",
      "box": {
        "x": 60,
        "y": 118,
        "width": 1080,
        "height": 136
      },
      "lines": [
        {
          "text": "A stale save must not",
          "x": 0,
          "baseline": 56.5,
          "width": 592.6199999999999
        },
        {
          "text": "erase a newer edit.",
          "x": 0,
          "baseline": 124.5,
          "width": 529.86
        }
      ]
    },
    {
      "componentId": "setup",
      "box": {
        "x": 60,
        "y": 278,
        "width": 1080,
        "height": 96
      },
      "lines": [
        {
          "text": "In fictional Folio, Leena and Omar both read document 42:",
          "x": 0,
          "baseline": 30.5,
          "width": 731.0239999999998
        },
        {
          "text": "“Launch notes”, revision 7. Then each changes the title.",
          "x": 0,
          "baseline": 70.5,
          "width": 694.6239999999998
        }
      ]
    },
    {
      "componentId": "mechanism-title",
      "box": {
        "x": 60,
        "y": 410,
        "width": 1080,
        "height": 48
      },
      "lines": [
        {
          "text": "Check the revision and write in one atomic update.",
          "x": 0,
          "baseline": 36.5,
          "width": 841.824
        }
      ]
    },
    {
      "componentId": "mechanism",
      "box": {
        "x": 60,
        "y": 470,
        "width": 1080,
        "height": 132
      },
      "lines": [
        {
          "text": "Match document ID + expected revision, write the title, increment the",
          "x": 0,
          "baseline": 30.5,
          "width": 870.6879999999994
        },
        {
          "text": "revision. Success means one row changed. Every title writer must use",
          "x": 0,
          "baseline": 70.5,
          "width": 869.6799999999994
        },
        {
          "text": "this contract; never reuse a revision, even after restoration.",
          "x": 0,
          "baseline": 110.5,
          "width": 738.1359999999999
        }
      ]
    },
    {
      "componentId": "two-saves",
      "elementId": "person-0",
      "box": {
        "x": 93.71945701357461,
        "y": 672.7398190045249,
        "width": 216.97199999999998,
        "height": 40
      },
      "lines": [
        {
          "text": "Leena saves first",
          "x": 0,
          "baseline": 30.5,
          "width": 216.97199999999998
        }
      ]
    },
    {
      "componentId": "two-saves",
      "elementId": "title-0",
      "box": {
        "x": 93.71945701357461,
        "y": 723.9705882352941,
        "width": 236.57200000000003,
        "height": 40
      },
      "lines": [
        {
          "text": "“Launch checklist”",
          "x": 0,
          "baseline": 30.5,
          "width": 236.57200000000003
        }
      ]
    },
    {
      "componentId": "two-saves",
      "elementId": "expects-0",
      "box": {
        "x": 93.71945701357461,
        "y": 778.6923076923076,
        "width": 194.30399999999997,
        "height": 32
      },
      "lines": [
        {
          "text": "expects revision 7",
          "x": 0,
          "baseline": 25,
          "width": 194.30399999999997
        }
      ]
    },
    {
      "componentId": "two-saves",
      "elementId": "rows-0",
      "box": {
        "x": 696.4343891402714,
        "y": 672.7398190045249,
        "width": 189.78400000000005,
        "height": 40
      },
      "lines": [
        {
          "text": "1 row changed",
          "x": 0,
          "baseline": 30.5,
          "width": 189.78400000000005
        }
      ]
    },
    {
      "componentId": "two-saves",
      "elementId": "stored-title-0",
      "box": {
        "x": 696.4343891402714,
        "y": 723.9705882352941,
        "width": 236.57200000000003,
        "height": 40
      },
      "lines": [
        {
          "text": "“Launch checklist”",
          "x": 0,
          "baseline": 30.5,
          "width": 236.57200000000003
        }
      ]
    },
    {
      "componentId": "two-saves",
      "elementId": "stored-revision-0",
      "box": {
        "x": 696.4343891402714,
        "y": 778.6923076923076,
        "width": 208.368,
        "height": 32
      },
      "lines": [
        {
          "text": "Stored at revision 8",
          "x": 0,
          "baseline": 25,
          "width": 208.368
        }
      ]
    },
    {
      "componentId": "two-saves",
      "elementId": "person-1",
      "box": {
        "x": 93.71945701357461,
        "y": 897.7533936651583,
        "width": 215.46000000000004,
        "height": 40
      },
      "lines": [
        {
          "text": "Omar saves next",
          "x": 0,
          "baseline": 30.5,
          "width": 215.46000000000004
        }
      ]
    },
    {
      "componentId": "two-saves",
      "elementId": "title-1",
      "box": {
        "x": 93.71945701357461,
        "y": 948.9841628959276,
        "width": 203.30800000000002,
        "height": 40
      },
      "lines": [
        {
          "text": "“Release notes”",
          "x": 0,
          "baseline": 30.5,
          "width": 203.30800000000002
        }
      ]
    },
    {
      "componentId": "two-saves",
      "elementId": "expects-1",
      "box": {
        "x": 93.71945701357461,
        "y": 1003.7058823529412,
        "width": 194.30399999999997,
        "height": 32
      },
      "lines": [
        {
          "text": "expects revision 7",
          "x": 0,
          "baseline": 25,
          "width": 194.30399999999997
        }
      ]
    },
    {
      "componentId": "two-saves",
      "elementId": "rows-1",
      "box": {
        "x": 696.4343891402714,
        "y": 897.7533936651583,
        "width": 345.0160000000001,
        "height": 40
      },
      "lines": [
        {
          "text": "0 rows · HTTP 409 Conflict",
          "x": 0,
          "baseline": 30.5,
          "width": 345.0160000000001
        }
      ]
    },
    {
      "componentId": "two-saves",
      "elementId": "stored-title-1",
      "box": {
        "x": 696.4343891402714,
        "y": 948.9841628959276,
        "width": 236.57200000000003,
        "height": 40
      },
      "lines": [
        {
          "text": "“Launch checklist”",
          "x": 0,
          "baseline": 30.5,
          "width": 236.57200000000003
        }
      ]
    },
    {
      "componentId": "two-saves",
      "elementId": "stored-revision-1",
      "box": {
        "x": 696.4343891402714,
        "y": 1003.7058823529412,
        "width": 293.616,
        "height": 32
      },
      "lines": [
        {
          "text": "Revision 8 stays untouched",
          "x": 0,
          "baseline": 25,
          "width": 293.616
        }
      ]
    },
    {
      "componentId": "recovery-title",
      "box": {
        "x": 60,
        "y": 1130,
        "width": 1080,
        "height": 60
      },
      "lines": [
        {
          "text": "After the conflict, show both versions.",
          "x": 0,
          "baseline": 36.5,
          "width": 632.5560000000002
        }
      ]
    },
    {
      "componentId": "recovery",
      "box": {
        "x": 60,
        "y": 1202,
        "width": 1080,
        "height": 132
      },
      "lines": [
        {
          "text": "Fetch revision 8. Let Omar keep Leena’s title, revise it, or deliberately",
          "x": 0,
          "baseline": 30.5,
          "width": 861.8679999999995
        },
        {
          "text": "replace it. Any new save uses the fetched revision and can conflict",
          "x": 0,
          "baseline": 70.5,
          "width": 826.9799999999997
        },
        {
          "text": "again. Never silently retry Omar’s stale title with a newer revision.",
          "x": 0,
          "baseline": 110.5,
          "width": 820.8759999999995
        }
      ]
    },
    {
      "componentId": "limits",
      "box": {
        "x": 60,
        "y": 1394,
        "width": 1080,
        "height": 144
      },
      "lines": [
        {
          "text": "Why atomic? Separate checks can both pass before either write.",
          "x": 0,
          "baseline": 25,
          "width": 686.7599999999999
        },
        {
          "text": "Scope: one document; no deletion. This does not merge edits or make",
          "x": 0,
          "baseline": 57,
          "width": 749.6160000000001
        },
        {
          "text": "multi-document changes atomic. A lost success response can look like",
          "x": 0,
          "baseline": 89,
          "width": 757.9440000000001
        },
        {
          "text": "a later conflict: revision checks alone do not deduplicate requests.",
          "x": 0,
          "baseline": 121,
          "width": 710.1119999999999
        }
      ]
    }
  ]
}
`;

