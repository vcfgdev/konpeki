{
  "name": "konpeki",
  "version": "0.4.0",
  "description": "Agent-first HTML visual authoring and review",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vcfgdev/konpeki.git"
  },
  "homepage": "https://github.com/vcfgdev/konpeki#readme",
  "bugs": "https://github.com/vcfgdev/konpeki/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "konpeki": "runtime/konpeki.mjs"
  },
  "files": [
    "AGENTS.md",
    "AUTHORING.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "SETUP.md",
    "README.md",
    "LICENSE",
    "theme.css",
    "theme-base.css",
    "fonts/*.woff2",
    "fonts/*OFL.txt",
    "docs/workflow.md",
    "docs/development.md",
    "plugin.json",
    "skills/konpeki/SKILL.md",
    "skills/konpeki/floor.md",
    "skills/konpeki/scripts/*.mjs",
    "skills/konpeki/assets/blank.html",
    "html/*.{ts,tsx,css,html,md}",
    "runtime/**/*.{mjs,js}",
    "index.html",
    "vite.config.ts",
    "public/og.png",
    "src/components/PageBoard.tsx",
    "src/lib/{page-board,alignment,review-position}.ts",
    "src/styles/{base,shell,feedback}.css",
    "src/assets/konpeki-mark.png",
    "!**/*.test.ts"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4318",
    "build": "vite build",
    "prepack": "node scripts/build-cli.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4318",
    "check": "tsc --noEmit",
    "test": "node --test html/*.test.ts src/lib/*.test.ts scripts/*.test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "konpeki": "node bin/konpeki.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "parse5": "8.0.0",
    "pdf-lib": "1.17.1",
    "playwright": "1.63.0",
    "postcss": "8.5.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^5.9.3"
  }
}
