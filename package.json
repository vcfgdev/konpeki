{
  "name": "konpeki",
  "version": "0.3.1",
  "description": "A shared editable canvas for agent-made visuals",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vcfgdev/konpeki.git"
  },
  "homepage": "https://github.com/vcfgdev/konpeki#readme",
  "bugs": "https://github.com/vcfgdev/konpeki/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "konpeki": "runtime/konpeki.mjs"
  },
  "files": [
    "AGENTS.md",
    "AUTHORING.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "SETUP.md",
    "docs/workflow.md",
    "docs/development.md",
    "plugin.json",
    "skills/konpeki/SKILL.md",
    "skills/konpeki/scripts/*.mjs",
    "skills/konpeki/assets/blank.json",
    "runtime/konpeki.mjs",
    "index.html",
    "vite.config.ts",
    "public/og.png",
    "src/main.tsx",
    "src/app/*.tsx",
    "src/components/*.tsx",
    "src/lib/*.ts",
    "src/lib/examples/react-page-migration.json",
    "src/styles/*.css",
    "src/assets/konpeki-mark.png",
    "composition/{README.md,compile.ts,document.ts,schema.json,schema.ts,theme-tokens.ts,types.ts,validate.ts,vector.ts,visualizations.ts}",
    "design/*.md",
    "design/{palettes,themes}/*.{md,ts}",
    "design/review/*.md",
    "design/visual-languages/technical-product.md",
    "lib/{assets.d.ts,charts.ts,contrast.ts,layouts.ts,slide.tsx,taste.ts,text.tsx,typeface.ts}",
    "scripts/migrate-react-page.ts",
    "slides/README.md",
    "slides/drawing-references.md",
    "slides/{architecture,article-brief,bar-chart,comparison,decision-memo,delivery-plan,experiment,incident-workflow,line-chart,migration,og-images,product-introduction,research-brief,results-explanation,retrospective,sankey,teaching,vertical-bar-charts}/{PROMPT.md,index.tsx}",
    "slides/introducing-konpeki/{README.md,PROMPT.md,SOURCE.md,composition.json,author.ts}",
    "slides/github-cover/{README.md,PROMPT.md,composition.json,author.ts}",
    "!**/*.test.ts"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4318",
    "build": "vite build",
    "prepack": "node scripts/build-cli.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4318",
    "check": "tsc --noEmit",
    "test": "node --test lib/*.test.ts composition/*.test.ts src/lib/*.test.ts bin/*.test.ts",
    "check:package": "node scripts/check-package.mjs",
    "konpeki": "node bin/konpeki.mjs",
    "composition:generate": "node composition/generate.ts",
    "example:migrate-page": "node scripts/migrate-react-page.ts"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-serif": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "@nivo/bar": "0.99.0",
    "@nivo/line": "0.99.0",
    "@nivo/sankey": "0.99.0",
    "@xmldom/xmldom": "0.9.12",
    "ajv": "^8.20.0",
    "proper-lockfile": "4.1.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^5.9.3"
  }
}
